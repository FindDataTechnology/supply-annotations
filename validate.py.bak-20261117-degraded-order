#!/usr/bin/env python3
"""供给注释校验器（只读，不写任何注释文件）。

五道门，任何一道失败即非零退出并点名：

  1. 形状      —— 复用 paas lib/supply-annotations.js 的等价规则
                  （human.zh 必填、name≤60 / summary≤200 / whenToUse≤160 / brief≤300）
  2. 键对齐    —— server == 文件名 == registry name；tools 键 ⊆ 上游工具名
  3. 覆盖      —— tools 键集合 == registry tool_list 名字集合（缺/多都红）
  4. 五语      —— 每轨必须有 zh/en/ja/es/fr；server 级有 whenToUse
  5. 禁辞      —— 绝对化表述与禁用别名

工具面取数：默认从生产 registry 只读取（与 scripts/reconcile_mcp_registry.py 同法）；
离线用 --no-registry 退回 _sources 快照。

用法：
    python3 supply-annotations/validate.py
    python3 supply-annotations/validate.py --only fd-quant
    python3 supply-annotations/validate.py --no-registry
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
MCP_DIR = ROOT / "mcp"
SKILLS_DIR = ROOT / "skills"
SRC_DIR = ROOT / "_sources"

LOCALES = ["zh", "en", "ja", "es", "fr"]
NAME_MAX, SUMMARY_MAX, WHEN_MAX, BRIEF_MAX = 60, 200, 160, 300

#: skill 域（add-skill-supply-annotations）：两域 origin 与快照锚
SKILL_ORIGINS = ("registry", "yizuo-file")
SKILL_ANCHOR_FILES = {
    "registry": SRC_DIR / "skills.registry.json",
    "yizuo-file": SRC_DIR / "skills.yizuo-file.json",
}
#: 2.4 快照陈旧告警窗口（天）——告警不红
SNAPSHOT_STALE_DAYS = 14

#: 绝对化表述（与 docs/marketing/audit.py 同款口径的收窄版）
BANNED_PATTERNS = [
    "最好", "最强", "唯一", "第一", "绝对", "100%", "零风险", "必赚", "稳赚",
    "best ", "the only", "number one", "#1", "guaranteed", "risk-free", "zero risk",
    "最高", "最全", "首创", "独家",
]
#: glossary §7 禁用别名（按条目文本整体命中）
BANNED_ALIASES = ["舰队", "工具集", "数据仓库", "接口文档"]

#: task 2.5 哨兵：readOnlyHint=true 的工具，注释不得断言「写持久状态」。
#: 动词表保守收窄（只收无争议的状态写入义；「生成/返回/输出」是产出不是写状态；
#: 「覆盖」单独命中多为「覆盖度/覆盖信息」名词义，只收「覆盖写入」）。
WRITE_VERBS_ZH = [
    "写入", "保存", "落盘", "持久化", "删除", "清除", "清空", "抹除", "修改",
    "发布", "上架", "下架", "订阅", "退订", "停用", "吊销", "撤销", "重试",
    "回滚", "更正", "登记", "落账", "记账", "下单", "撤单", "铸造",
    "挂载", "安装", "卸载", "导入", "覆盖写入",
]
WRITE_VERBS_EN = [
    "write", "save", "persist", "delete", "remove", "destroy", "modify",
    "publish", "subscribe", "unsubscribe", "revoke", "retry", "revert",
    "mint", "install", "uninstall", "import", "overwrite",
]

#: 命中前先剥掉的被动/名词语态（「保存済み/已保存/发布时间」描述既有状态或时间属性，
#: 不是本工具的写动作）；剥完再匹配动词。
PASSIVE_NOUNS = [
    "保存済み", "保存された", "已保存", "已存",
    "发布时间", "发布日期", "publish time", "publish date", "published",
]

#: 已知误报白名单：(entry, leaf, verb) —— 语义确属产出而非写状态时在此豁免并注因
WRITE_VERB_EXEMPT: set[tuple[str, str, str]] = set()

#: registry 读面的定位。pod 名**不写死**——写死会在每次滚动后静默失配，
#: 而失配的回退是 `_sources` 快照，于是「上游缺工具」的红是旧快照的红，
#: 不是 registry 的红（2026-11-08 实测：pod 名与 context 双双过期，
#: 校验一直离线跑，酒店五工具被误判为「上游没有」）。
_KUBECTL_NS = "mcp-registry"
_KUBECTL_CTX = os.environ.get("FD_KUBECTL_CTX", "cheap-ts")
_KUBECTL_SELECTOR = "app.kubernetes.io/name=registry"


def fail(errors: list[str], msg: str) -> None:
    errors.append(msg)


def check_track(track: dict, entry: str, require_when: bool, errors: list[str]) -> None:
    if not isinstance(track, dict):
        fail(errors, f"{entry}: track 不是对象")
        return
    for key in track:
        if key not in ("name", "summary", "whenToUse"):
            fail(errors, f"{entry}: 未知键 '{key}'（只允许 name/summary/whenToUse）")
    name, summary = track.get("name"), track.get("summary")
    if not isinstance(name, str) or not name.strip() or len(name) > NAME_MAX:
        fail(errors, f"{entry}.name 必须是 1..{NAME_MAX} 字符的字符串")
    if not isinstance(summary, str) or not summary.strip() or len(summary) > SUMMARY_MAX:
        fail(errors, f"{entry}.summary 必须是 1..{SUMMARY_MAX} 字符的字符串")
    when = track.get("whenToUse")
    if require_when:
        if not isinstance(when, str) or not when.strip() or len(when) > WHEN_MAX:
            fail(errors, f"{entry}.whenToUse 必须是 1..{WHEN_MAX} 字符的字符串（server 级必填）")
    elif when is not None:
        fail(errors, f"{entry}.whenToUse 工具级不写（server 级才写）")


# ── skill 域（add-skill-supply-annotations）──────────────────────────────────

def check_skill_track(track: dict, where: str, errors: list[str]) -> None:
    """skill 轨：同 MCP 形状，但 whenToUse 可选（skill 级何时用写出来更有意义）。"""
    if not isinstance(track, dict):
        fail(errors, f"{where}: track 不是对象")
        return
    for key in track:
        if key not in ("name", "summary", "whenToUse"):
            fail(errors, f"{where}: 未知键 '{key}'（只允许 name/summary/whenToUse）")
    name, summary = track.get("name"), track.get("summary")
    if not isinstance(name, str) or not name.strip() or len(name) > NAME_MAX:
        fail(errors, f"{where}.name 必须是 1..{NAME_MAX} 字符的字符串")
    if not isinstance(summary, str) or not summary.strip() or len(summary) > SUMMARY_MAX:
        fail(errors, f"{where}.summary 必须是 1..{SUMMARY_MAX} 字符的字符串")
    when = track.get("whenToUse")
    if when is not None and (not isinstance(when, str) or not when.strip() or len(when) > WHEN_MAX):
        fail(errors, f"{where}.whenToUse 写了就必须是 1..{WHEN_MAX} 字符的字符串")


def skill_anchor_names(origin: str) -> set[str] | None:
    """域锚：快照里的技能名全集。缺快照文件返回 None（覆盖门退化为告警）。"""
    p = SKILL_ANCHOR_FILES.get(origin)
    if not p or not p.exists():
        return None
    try:
        doc = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return {s["name"] for s in doc.get("skills", []) if isinstance(s, dict) and s.get("name")}


def snapshot_age_days(origin: str) -> int | None:
    p = SKILL_ANCHOR_FILES.get(origin)
    if not p or not p.exists():
        return None
    try:
        doc = json.loads(p.read_text(encoding="utf-8"))
        gen = doc.get("generatedAt", "")
        # generatedAt 形如 2026-11-04T...Z
        import datetime as _dt
        gen_dt = _dt.datetime.fromisoformat(gen.replace("Z", "+00:00"))
        return (_dt.datetime.now(_dt.timezone.utc) - gen_dt).days
    except Exception:
        return None


def validate_skill_entry(name: str, doc: dict, anchor: str | None, errors: list[str]) -> None:
    """一条 skill 注释文件的形状 + 键对齐校验（覆盖门在域层跑）。"""
    origin = doc.get("origin")
    if origin not in SKILL_ORIGINS:
        fail(errors, f"{name}: origin 缺失或非法（只允许 {'/'.join(SKILL_ORIGINS)}）")
        return
    if anchor is not None and name not in anchor:
        fail(errors, f"{name}: 技能键不在 {origin} 域快照中（多余或拼错）")
    if doc.get("skill") != name:
        fail(errors, f"{name}: skill 字段 '{doc.get('skill')}' 与文件名不一致")
    ann = doc.get("annotation")
    if not isinstance(ann, dict):
        fail(errors, f"{name}: 缺 annotation")
        return
    human = ann.get("human")
    if not isinstance(human, dict) or not isinstance(human.get("zh"), dict):
        fail(errors, f"{name}: annotation.human.zh 主轨必填")
        return
    for loc in LOCALES:
        if loc not in human:
            fail(errors, f"{name}.human 缺 {loc} 轨")
        else:
            check_skill_track(human[loc], f"{name}.human.{loc}", errors)
            for v in human[loc].values():
                if isinstance(v, str):
                    scan_text(v, f"{name}.human.{loc}", errors)
    for loc in human:
        if loc not in LOCALES:
            fail(errors, f"{name}.human 出现未知 locale '{loc}'")
    canon = ann.get("canonical")
    if canon is not None:
        if not isinstance(canon, dict) or not isinstance(canon.get("brief"), str) or not canon["brief"].strip():
            fail(errors, f"{name}.canonical 写了就必须是 {{brief: 非空字符串}} 对象")
        elif len(canon["brief"]) > BRIEF_MAX:
            fail(errors, f"{name}.canonical.brief 超过 {BRIEF_MAX} 字符")
    prov = ann.get("provenance")
    if not isinstance(prov, dict) or not str(prov.get("source") or "").strip():
        fail(errors, f"{name}.provenance.source 必填")


def validate_skills_domain(errors: list[str], warnings: list[str]) -> dict:
    """skill 两域：逐文件校验 + 分域覆盖门 + 快照陈旧告警。返回统计。"""
    stats = {"files": 0, "by_origin": {"registry": 0, "yizuo-file": 0}}
    if not SKILLS_DIR.exists():
        for origin in SKILL_ORIGINS:
            anchor = skill_anchor_names(origin)
            if anchor:
                fail(errors, f"skill 覆盖缺 {len(anchor)} 个技能（{origin} 域无任何注释文件）: {', '.join(sorted(anchor)[:8])}…")
        return stats

    files = sorted(SKILLS_DIR.glob("*.json"))
    by_origin: dict[str, set[str]] = {o: set() for o in SKILL_ORIGINS}
    for p in files:
        name = p.stem
        try:
            doc = json.loads(p.read_text(encoding="utf-8"))
        except Exception as e:
            fail(errors, f"{name}: JSON 解析失败: {e}")
            continue
        origin = doc.get("origin")
        if origin in SKILL_ORIGINS:
            by_origin[origin].add(name)
            stats["by_origin"][origin] += 1
        stats["files"] += 1
        anchor = skill_anchor_names(origin) if origin in SKILL_ORIGINS else None
        validate_skill_entry(name, doc, anchor, errors)
        ok = not any(e.startswith(name) for e in errors)
        print(f"  [skill:{origin or '?'}] {name:40} {'✓' if ok else '✗'}")

    # 分域覆盖门：键集合 == 快照全集（缺/多两侧点名）；缺快照文件时告警不红
    for origin in SKILL_ORIGINS:
        anchor = skill_anchor_names(origin)
        if anchor is None:
            warnings.append(f"{origin} 域快照缺失（_sources/skills.{origin}.json），覆盖门跳过")
            continue
        got = by_origin[origin]
        missing = sorted(anchor - got)
        extra = sorted(got - anchor)
        if missing:
            fail(errors, f"skill 覆盖缺 {len(missing)} 个技能（{origin} 域）: {', '.join(missing[:8])}{'…' if len(missing) > 8 else ''}")
        if extra:
            fail(errors, f"skill 注释多出 {len(extra)} 个技能（{origin} 域）: {', '.join(extra[:8])}{'…' if len(extra) > 8 else ''}")
        age = snapshot_age_days(origin)
        if age is not None and age > SNAPSHOT_STALE_DAYS:
            warnings.append(f"{origin} 域快照已 {age} 天未更新（窗口 {SNAPSHOT_STALE_DAYS} 天）——重取清单快照以保鲜覆盖门")
    return stats


def manifest_hints(entry: str) -> dict[str, dict] | None:
    """条目对应仓的 tool-surface.json tool_annotations（readOnlyHint 等）。无则 None。"""
    for cand in (ROOT.parent / entry, ROOT.parent / "facet-ops-mcp"):
        p = cand / "tool-surface.json"
        if p.exists():
            try:
                doc = json.loads(p.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                return None
            ta = doc.get("tool_annotations")
            return ta if isinstance(ta, dict) else None
    return None


def check_manifest_consistency(entry: str, tools: dict, errors: list[str]) -> None:
    """task 2.5：readOnlyHint=true 的工具，其五语 name/summary 与 brief 不得断言写状态。"""
    hints = manifest_hints(entry)
    if not hints:
        return
    for leaf, ann in tools.items():
        hint = hints.get(leaf)
        if not isinstance(hint, dict) or hint.get("readOnlyHint") is not True:
            continue
        texts: list[tuple[str, str]] = []  # (字段路径, 文本)
        for loc in LOCALES:
            track = (ann.get("human") or {}).get(loc) or {}
            texts.append((f"human.{loc}.name", str(track.get("name") or "")))
            texts.append((f"human.{loc}.summary", str(track.get("summary") or "")))
        brief = str((ann.get("canonical") or {}).get("brief") or "")
        texts.append(("canonical.brief", brief))
        for field, raw in texts:
            text = raw
            for noun in PASSIVE_NOUNS:
                text = text.replace(noun, "")
            for verb in WRITE_VERBS_ZH:
                if verb in text and (entry, leaf, verb) not in WRITE_VERB_EXEMPT:
                    fail(errors, f"{entry}.tools['{leaf}'].{field}: 只读工具命中写状态动词 '{verb}': {text[:60]}")
            low = text.lower()
            for verb in WRITE_VERBS_EN:
                if re.search(rf"\b{verb}\b", low) and (entry, leaf, verb) not in WRITE_VERB_EXEMPT:
                    fail(errors, f"{entry}.tools['{leaf}'].{field}: 只读工具命中写状态动词 '{verb}': {text[:60]}")


def scan_text(text: str, where: str, errors: list[str]) -> None:
    low = text.lower()
    for pat in BANNED_PATTERNS:
        if pat.lower() in low:
            fail(errors, f"{where}: 命中绝对化表述 '{pat}'")
    for alias in BANNED_ALIASES:
        if alias in text:
            fail(errors, f"{where}: 命中禁用别名 '{alias}'（见 glossary §7）")


def load_source(entry: str) -> dict:
    p = SRC_DIR / f"{entry}.tools.json"
    if not p.exists():
        return {}
    return json.loads(p.read_text(encoding="utf-8"))


