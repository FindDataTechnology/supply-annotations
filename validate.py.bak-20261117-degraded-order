#: 最近一次成功取数的来源描述（main 打印它——「静默回退到快照」不再无声）。
SOURCE_NOTE = ""


def _registry_pod() -> str | None:
    """按 label 现取 Running 的 registry pod。滚动即变，写死必失配。"""
    try:
        proc = subprocess.run(
            ["kubectl", "--context", _KUBECTL_CTX, "-n", _KUBECTL_NS, "get", "pods",
             "-l", _KUBECTL_SELECTOR, "--field-selector=status.phase=Running",
             "-o", "jsonpath={.items[0].metadata.name}"],
            capture_output=True, text=True, timeout=30,
        )
        name = proc.stdout.strip()
        return name or None
    except Exception:
        return None


def registry_tools(entries: list[str]) -> dict[str, list[str]] | None:
    """只读拉取生产 registry 的 tool_list 名字集合（spine 投影优先，mongo 副本兜底）。

    两条腿都失败返回 None —— 调用方据此显式退回 `_sources` 快照并**打印**来源，
    快照的红就标成快照的红，不再冒充 registry 的红。
    """
    global SOURCE_NOTE
    pod = _registry_pod()
    if not pod:
        SOURCE_NOTE = f"registry pod 未取到（context={_KUBECTL_CTX} ns={_KUBECTL_NS}）"
        return None
    for script, label in ((_SPINE_SCRIPT, "spine 投影"), (_MONGO_SCRIPT, "mongo 副本")):
        try:
            proc = subprocess.run(
                ["kubectl", "--context", _KUBECTL_CTX, "-n", _KUBECTL_NS, "exec", pod,
                 "--", "/app/.venv/bin/python3", "-c", script],
                capture_output=True, text=True, timeout=90,
            )
            if proc.returncode != 0:
                continue
            payload = json.loads(proc.stdout.strip().splitlines()[-1])
            servers = payload.get("servers") or {}
            if not servers:
                continue
            as_of = payload.get("asOf")
            SOURCE_NOTE = f"{label}@{pod}" + (f"（asOf {as_of}）" if as_of else "")
            return servers
        except Exception:
            continue
    SOURCE_NOTE = f"两条读面皆失败（{pod}）"
    return None


def validate_entry(name: str, doc: dict, upstream_names: list[str] | None, errors: list[str]) -> dict:
    stats = {"tools": 0, "locales": 0}
    if doc.get("server") != name:
        fail(errors, f"{name}: server 字段 '{doc.get('server')}' 与文件名不一致")
    ann = doc.get("annotation")
    if not isinstance(ann, dict):
        fail(errors, f"{name}: 缺 annotation")
        return stats
    human = ann.get("human")
    if not isinstance(human, dict) or not isinstance(human.get("zh"), dict):
        fail(errors, f"{name}: annotation.human.zh 主轨必填")
        return stats
    for loc in LOCALES:
        if loc not in human:
            fail(errors, f"{name}.human 缺 {loc} 轨")
        else:
            check_track(human[loc], f"{name}.human.{loc}", require_when=True, errors=errors)
            for v in human[loc].values():
                if isinstance(v, str):
                    scan_text(v, f"{name}.human.{loc}", errors)
    for loc in human:
        if loc not in LOCALES:
            fail(errors, f"{name}.human 出现未知 locale '{loc}'")
    canon = ann.get("canonical")
    if not isinstance(canon, dict) or not isinstance(canon.get("brief"), str):
        fail(errors, f"{name}.canonical.brief 必填")
    elif len(canon["brief"]) > BRIEF_MAX:
        fail(errors, f"{name}.canonical.brief 超过 {BRIEF_MAX} 字符")
    prov = ann.get("provenance")
    if not isinstance(prov, dict) or not str(prov.get("source") or "").strip():
        fail(errors, f"{name}.provenance.source 必填")

    tools = ann.get("tools") or {}
    if not isinstance(tools, dict):
        fail(errors, f"{name}.annotation.tools 必须是对象")
        return stats
    stats["tools"] = len(tools)
    for leaf, tola in tools.items():
        where = f"{name}.tools['{leaf}']"
        if upstream_names is not None and leaf not in upstream_names:
            fail(errors, f"{where}: 该工具不在上游 tool_list 中（多余或拼错）")
        if not isinstance(tola, dict):
            fail(errors, f"{where}: 不是对象")
            continue
        th = tola.get("human")
        if not isinstance(th, dict):
            fail(errors, f"{where}.human 缺失")
            continue
        for loc in LOCALES:
            if loc not in th:
                fail(errors, f"{where}.human 缺 {loc} 轨")
            else:
                check_track(th[loc], f"{where}.human.{loc}", require_when=False, errors=errors)
                for v in th[loc].values():
                    if isinstance(v, str):
                        scan_text(v, f"{where}.human.{loc}", errors)
        tc = tola.get("canonical")
        if not isinstance(tc, dict) or not isinstance(tc.get("brief"), str):
            fail(errors, f"{where}.canonical.brief 必填")
        elif len(tc["brief"]) > BRIEF_MAX:
            fail(errors, f"{where}.canonical.brief 超过 {BRIEF_MAX} 字符")
    check_manifest_consistency(name, tools, errors)
    # 覆盖门
    if upstream_names is not None:
        missing = sorted(set(upstream_names) - set(tools))
        extra = sorted(set(tools) - set(upstream_names))
        if missing:
            fail(errors, f"{name}: 覆盖缺 {len(missing)} 个工具: {', '.join(missing[:8])}{'…' if len(missing) > 8 else ''}")
        if extra:
            fail(errors, f"{name}: 注释多出 {len(extra)} 个工具: {', '.join(extra[:8])}{'…' if len(extra) > 8 else ''}")
    stats["locales"] = len([l for l in LOCALES if l in human]) * (1 + len(tools))
    return stats


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", help="只校验某条目")
    ap.add_argument("--no-registry", action="store_true", help="不查生产 registry，退回 _sources 快照")
    args = ap.parse_args()

    files = sorted(MCP_DIR.glob("*.json"))
    if args.only:
        files = [p for p in files if p.stem == args.only]
        if not files:
            print(f"未找到 {args.only}.json", file=sys.stderr)
            return 2
    if not files:
        print("错误：supply-annotations/mcp/ 下没有任何注释文件", file=sys.stderr)
        return 2

    live = None if args.no_registry else registry_tools([p.stem for p in files])
    degraded = False
    if args.no_registry:
        source_mode = "_sources 快照（--no-registry 显式指定）"
    elif live is not None:
        source_mode = f"registry(生产只读)：{SOURCE_NOTE}"
    else:
        # 回退也要点名原因：快照的红不是 registry 的红（2026-11-08 教训）。
        source_mode = f"_sources 快照（registry 不可读：{SOURCE_NOTE or '未知原因'}）"
        # retire-orphan-platform-state 4.1/4.3：读不到活来源不得仍输出确定结论。
        # 旧实现回退后照样「全部校验通过」+ exit 0——快照上的绿与 registry 上的绿
        # 不可区分，红绿都不可信。现在隐式回退 = degraded=true + exit 2（判不出，
        # 不是通过也不是失败）；显式 --no-registry 是刻意选择，保持 exit 0。
        degraded = True
    print(f"工具面来源：{source_mode}")
    if degraded:
        print("degraded=true：registry 不可读，本轮基于 _sources 快照——不构成「通过」；"
              "确要按快照校验请显式 --no-registry", file=sys.stderr)

    errors: list[str] = []
    total_tools = 0
    for p in files:
        name = p.stem
        try:
            doc = json.loads(p.read_text(encoding="utf-8"))
        except Exception as e:
            fail(errors, f"{name}: JSON 解析失败: {e}")
            continue
        if live is not None:
            upstream = live.get(name)
            if upstream is None:
                fail(errors, f"{name}: registry 中无此条目")
                upstream = None
        else:
            src = load_source(name)
            upstream = [t["name"] for t in src.get("tools", [])] if src else None
            if upstream is None:
                fail(errors, f"{name}: 缺 _sources/{name}.tools.json 且未连 registry")
        stats = validate_entry(name, doc, upstream, errors)
        total_tools += stats["tools"]
        print(f"  {name:32} tools={stats['tools']:>4}  ✓" if not any(e.startswith(name) for e in errors) else f"  {name:32} tools={stats['tools']:>4}  ✗")

    print(f"\n条目 {len(files)}，工具 {total_tools}")

    # ── skill 域（add-skill-supply-annotations）─────────────────────────────
    warnings: list[str] = []
    sk_stats = validate_skills_domain(errors, warnings)
    if sk_stats["files"]:
        print(
            f"技能 {sk_stats['files']}"
            f"（registry {sk_stats['by_origin']['registry']} / yizuo-file {sk_stats['by_origin']['yizuo-file']}）"
        )

    if warnings:
        print("告警（不红）：", file=sys.stderr)
        for w in warnings:
            print(f"  ! {w}", file=sys.stderr)
    if errors:
        print(f"失败 {len(errors)} 项：", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1
    if degraded:
        print("判不出（degraded）：registry 不可读，快照上没有「通过」可言", file=sys.stderr)
        return 2
    print("全部校验通过")
    return 0


if __name__ == "__main__":
    sys.exit(main())
