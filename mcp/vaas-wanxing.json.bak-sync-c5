    }
   },
   "generate_video_submit": {
    "human": {
     "zh": {
      "name": "提交视频任务",
      "summary": "提交异步视频任务，返回任务标识；之后轮询视频任务状态直至成功或失败，超时不要重复提交。"
     },
     "en": {
      "name": "Submit video job",
      "summary": "Submits an async video job and returns a job id; poll the job status until it succeeds or fails, and do not resubmit on a client timeout."
     },
     "ja": {
      "name": "動画ジョブを送信",
      "summary": "非同期の動画ジョブを送信し、ジョブ ID を返します。成功または失敗まで状態をポーリングし、タイムアウト時に再送信しないでください。"
     },
     "es": {
      "name": "Enviar trabajo de video",
      "summary": "Envía un trabajo de video asíncrono y devuelve un id de trabajo; consulta el estado hasta que termine y no lo reenvíes si hay tiempo de espera."
     },
     "fr": {
      "name": "Soumettre un travail vidéo",
      "summary": "Soumet un travail vidéo asynchrone et renvoie un identifiant ; interrogez l'état jusqu'à la fin et ne le resoumettez pas en cas de délai d'attente."
     }
    },
    "canonical": {
     "brief": "Submits an async video job and returns a job id; poll status until success or failure and never resubmit after a timeout."
    }
   },
   "generate_voice": {
    "human": {
     "zh": {
      "name": "合成语音",
      "summary": "由文本合成语音并返回产物；传入幂等键时，同键重放返回既有产物，不重复生成与计费。"
     },
     "en": {
      "name": "Generate speech",
      "summary": "Synthesizes speech from text and returns an asset; with an idempotency key, a repeat call replays the existing asset without regenerating or re-billing."
     },
     "ja": {
      "name": "音声を合成",
      "summary": "テキストから音声を合成し成果物を返します。冪等キーを渡すと、同じキーの再呼び出しは既存の成果物を返し、再生成や再課金を行いません。"
     },
     "es": {
      "name": "Generar voz",
      "summary": "Sintetiza voz a partir de texto y devuelve un artefacto; con clave de idempotencia, una repetición devuelve el artefacto existente sin regenerar ni facturar de nuevo."
     },
     "fr": {
      "name": "Générer la voix",
      "summary": "Synthétise une voix à partir d'un texte et renvoie un artefact ; avec une clé d'idempotence, un rappel renvoie l'artefact existant sans régénérer ni facturer à nouveau."
     }
    },
    "canonical": {
     "brief": "Generates speech from text and returns an asset; an idempotency key makes repeat calls replay the existing asset without regenerating or re-billing."
    }
   },
