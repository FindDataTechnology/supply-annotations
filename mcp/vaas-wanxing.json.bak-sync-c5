     },
     "es": {
      "name": "Listar plantillas de escena",
      "summary": "Enumera los componentes de plantilla de escena de los archivos de código scenes y devuelve la lista de plantillas."
     },
     "fr": {
      "name": "Lister les gabarits de scène",
      "summary": "Énumère les composants de gabarit de scène des fichiers source scenes et renvoie la liste des gabarits."
     }
    },
    "canonical": {
     "brief": "Lists scene template components from the scenes source files and returns the template list."
    }
   },
   "assets_list": {
    "human": {
     "zh": {
      "name": "列出产物",
      "summary": "按可选条件列出产物摘要；托管模式下只返回本租户自己的产物。"
     },
     "en": {
      "name": "List assets",
      "summary": "Lists asset summaries with optional filters; in hosted mode it returns just the tenant's own assets."
     },
     "ja": {
      "name": "成果物を一覧",
