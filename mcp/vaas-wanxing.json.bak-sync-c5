     },
     "es": {
      "name": "Listar artefactos",
      "summary": "Enumera resúmenes de artefactos con filtros opcionales; en modo alojado devuelve solo los artefactos del propio inquilino."
     },
     "fr": {
      "name": "Lister les artefacts",
      "summary": "Énumère les résumés d'artefacts avec filtres optionnels ; en mode hébergé, ne renvoie que les artefacts du locataire lui-même."
