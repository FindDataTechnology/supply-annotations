{
 "version": 1,
 "server": "vaas-wanxing",
 "annotation": {
  "human": {
   "zh": {
    "name": "萬星生成",
    "summary": "语音、图像、视频与封面的生成任务提交与状态查询，附资产库与模型音色目录。",
    "whenToUse": "需要生成配音、配图、短视频或封面并取回产物时。"
   },
   "en": {
    "name": "Wanxing generation",
    "summary": "Submit and track voice, image, video, and cover generation jobs, with an asset store and model/voice catalogue.",
    "whenToUse": "When you need narration, stills, short video, or covers and want the produced assets back."
   },
   "ja": {
    "name": "萬星ジェネレーション",
    "summary": "音声・画像・動画・カバーの生成ジョブを投入し、状態を確認。資産ストアとモデル・音声の一覧も提供します。",
    "whenToUse": "ナレーション、画像、短尺動画、カバーを生成して成果物を受け取りたいとき。"
   },
   "es": {
    "name": "Generación Wanxing",
    "summary": "Envío y seguimiento de trabajos de voz, imagen, vídeo y portada, con almacén de activos y catálogo de modelos y voces.",
    "whenToUse": "Cuando necesitas narración, imágenes, vídeo corto o portadas y quieres recuperar los activos."
   },
   "fr": {
    "name": "Génération Wanxing",
    "summary": "Soumission et suivi de tâches voix, image, vidéo et couverture, avec un magasin d'actifs et un catalogue de modèles et de voix.",
    "whenToUse": "Pour produire une narration, des visuels, une vidéo courte ou une couverture et récupérer les actifs."
   }
  },
  "canonical": {
   "brief": "Wanxing generation MCP: submit/poll voice, image, video, cover jobs; asset store and model/voice listing. Jobs are asynchronous."
  },
  "tools": {
   "assets_find_logo": {
    "human": {
     "zh": {
      "name": "查找公司标识",
      "summary": "在产物中查找公司标识素材，返回匹配的标识清单。"
     },
     "en": {
      "name": "Find company logo",
      "summary": "Finds company logo assets and returns the matching logo list."
     },
     "ja": {
      "name": "会社ロゴを検索",
      "summary": "成果物から会社ロゴの素材を検索し、該当するロゴの一覧を返します。"
     },
     "es": {
      "name": "Buscar el logotipo",
      "summary": "Busca los recursos de logotipo de la empresa y devuelve la lista de logotipos encontrados."
     },
     "fr": {
      "name": "Trouver le logo",
      "summary": "Recherche les ressources de logo de l'entreprise et renvoie la liste des logos trouvés."
     }
    },
    "canonical": {
     "brief": "Finds company logo assets and returns the matching logo list."
    }
   },
   "assets_get": {
    "human": {
     "zh": {
      "name": "读取产物详情",
      "summary": "读取单个产物的完整详情，含血缘、变体与分发信息；托管模式下附带新的签名下载地址。"
     },
     "en": {
      "name": "Get asset details",
      "summary": "Reads full details of one asset, including lineage, variants and distribution; in hosted mode it carries a fresh signed download URL."
     },
     "ja": {
      "name": "成果物詳細を取得",
      "summary": "単一の成果物の完全な詳細を読み取り、系譜、変種、配布情報を返します。ホスト型では新しい署名付きダウンロード URL を含みます。"
     },
     "es": {
      "name": "Obtener detalles del artefacto",
      "summary": "Lee los detalles completos de un artefacto, incluidos linaje, variantes y distribución; en modo alojado incluye una nueva URL de descarga firmada."
     },
     "fr": {
      "name": "Obtenir les détails d'un artefact",
      "summary": "Lit les détails complets d'un artefact, y compris la lignée, les variantes et la distribution ; en mode hébergé, une nouvelle URL de téléchargement signée est incluse."
     }
    },
    "canonical": {
     "brief": "Reads full details of one asset, including lineage, variants and distribution, with a fresh signed download URL in hosted mode."
    }
   },
   "assets_get_scene_templates": {
    "human": {
     "zh": {
      "name": "列出场景模板",
